# Copy this file to .env and fill in real values.
# On Render, set these same keys under Environment > Environment Variables instead of committing a .env file.

# MongoDB Atlas connection string (Database > Connect > Drivers)
# Falls back to a temporary in-memory database if unset/unreachable — fine for a quick demo, but all data is lost on restart.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/isoi_hackathon?retryWrites=true&w=majority

# Any long random string — used to sign login/session JWTs. Required, no default.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Optional: overrides the default seeded admin password (see config/adminSeed.js)
ADMIN_PASSWORD=change-me

# Optional: port the server listens on (Render sets this automatically)
PORT=5000
